# Copy this file to .env, then fill in local values.
# Never commit real credentials.

MEDIAGENT_DATA_DIR=/absolute/path/to/mediagent-data
MEDIAGENT_LIBRARY_DIR=/absolute/path/to/mediagent-library
MEDIAGENT_DB_PATH=/absolute/path/to/mediagent-data/mediagent.sqlite3
MEDIAGENT_LOG_PATH=/absolute/path/to/mediagent-data/mediagent.log

# Optional platform-specific library roots override MEDIAGENT_LIBRARY_DIR.
# These roots are already scoped to one platform, so files go under photo/video/audio below them.
# MEDIAGENT_PIXIV_LIBRARY_DIR=${MEDIAGENT_DATA_DIR}/pixiv
# MEDIAGENT_TELEGRAM_LIBRARY_DIR=${MEDIAGENT_DATA_DIR}/telegram

X_CLIENT_ID=
X_REDIRECT_URI=http://127.0.0.1:8765/callback
X_SCOPES="tweet.read users.read bookmark.read offline.access"
X_CREDENTIALS_FILE=${MEDIAGENT_DATA_DIR}/credentials/x-oauth.json

# First-time setup should use pixiv.auth.login, which writes this credential file.
PIXIV_CREDENTIALS_FILE=${MEDIAGENT_DATA_DIR}/credentials/pixiv-oauth.json

# Optional fallback if you already have a Pixiv refresh token.
PIXIV_REFRESH_TOKEN=

# Optional override. Defaults are embedded for the common Pixiv App API flow.
PIXIV_CLIENT_ID=
PIXIV_CLIENT_SECRET=
PIXIV_USER_ID=

# Telegram uses a user MTProto session. The session file is a credential.
# Create it through telegram.auth.login or Telethon-compatible tooling; never commit it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION_FILE=${MEDIAGENT_DATA_DIR}/credentials/telegram.session

# Optional. Only needed if Telegram asks for a 2FA password during telegram.auth.login complete.
# TELEGRAM_2FA_PASSWORD=

# Reddit uses OAuth. Create an app at https://www.reddit.com/prefs/apps and use a
# unique descriptive user agent such as: linux:mediagent:0.1 (by /u/your_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://127.0.0.1:8765/reddit/callback
REDDIT_USER_AGENT=
REDDIT_CREDENTIALS_FILE=${MEDIAGENT_DATA_DIR}/credentials/reddit-oauth.json

# Instagram uses a saved session created from local account credentials.
# The password should stay in local .env only and must never be committed.
INSTAGRAM_ACCOUNT=
INSTAGRAM_SECRET=
INSTAGRAM_SESSION_FILE=${MEDIAGENT_DATA_DIR}/credentials/instagram_session.json
