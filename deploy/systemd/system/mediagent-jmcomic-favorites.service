[Unit]
Description=Mediagent JMComic favorites follow sync
Documentation=file:/data/services/mediagent/deploy/systemd/system/README.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/data/services/mediagent/.env

[Service]
Type=oneshot
User=server
Group=server
WorkingDirectory=/data/services/mediagent
EnvironmentFile=/data/services/mediagent/.env
Environment=HOME=/home/server
Environment=PATH=/home/server/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/lock/mediagent-sync.lock /usr/bin/env uv run --locked mediagent tools run jmcomic.favorites.sync --input /data/services/mediagent/deploy/systemd/system/jmcomic.favorites.sync.json --summary-json
SuccessExitStatus=75
TimeoutStartSec=18h
UMask=0077
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
