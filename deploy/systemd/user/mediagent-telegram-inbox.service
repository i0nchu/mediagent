[Unit]
Description=Mediagent Telegram inbox sync
Documentation=file:/home/ion/projects/mediagent/deploy/systemd/user/README.md

[Service]
Type=oneshot
WorkingDirectory=/home/ion/projects/mediagent
EnvironmentFile=/home/ion/projects/mediagent/.env
ExecStart=/home/ion/.local/bin/uv run --locked mediagent tools run telegram.inbox.sync_links --input /home/ion/projects/mediagent/deploy/systemd/user/telegram.inbox.sync_links.json --json
TimeoutStartSec=2h
NoNewPrivileges=yes
