[Unit]
Description=Mediagent Pixiv bookmark sync
Documentation=file:/home/ion/projects/mediagent/deploy/systemd/user/README.md

[Service]
Type=oneshot
WorkingDirectory=/home/ion/projects/mediagent
EnvironmentFile=/home/ion/projects/mediagent/.env
ExecStart=/home/ion/.local/bin/uv run --locked mediagent tools run pixiv.bookmarks.sync --input /home/ion/projects/mediagent/deploy/systemd/user/pixiv.bookmarks.sync.json --json
TimeoutStartSec=2h
NoNewPrivileges=yes
